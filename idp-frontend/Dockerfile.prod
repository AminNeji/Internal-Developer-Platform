# Production image: Angular builds the static files, nginx serves them.
# The plain Dockerfile stays for local development (ng serve with live reload).
FROM node:20-alpine AS build

WORKDIR /app

COPY package*.json ./

RUN npm install --legacy-peer-deps

COPY . .

RUN npx ng build

FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/idp-frontend/browser /usr/share/nginx/html

EXPOSE 80
